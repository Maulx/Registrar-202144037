@model IEnumerable<Models.Course>

@functions {
    public IHtmlString Mark(string value)
    {
        string q = HttpContext.Current.Session["SearchString"] as string;

        if (String.IsNullOrWhiteSpace(q))
            return new HtmlString(HttpUtility.HtmlEncode(value));

        return new HtmlString(
            System.Text.RegularExpressions.Regex.Replace(
                HttpUtility.HtmlEncode(value),
                System.Text.RegularExpressions.Regex.Escape(HttpUtility.HtmlEncode(q)),
                "<mark>$0</mark>",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase
            )
        );
    }
}

@{
    var sessions =
        ((List<int>)Session["CoursesSessionsList"])
            .OrderBy(i => i);
}

@foreach (int session in sessions)
{
    var courses =
        Model.Where(c => c.Session == session);

    if (courses.Any())
    {
        <details id="courses_details_@session" open>
            <summary>Session @session</summary>

            @foreach (var item in courses)
            {
                <div class="StudentListLayout">
                    <a href="@Url.Action("Details", new { id = item.Id })">
                        <span class="studentCode">@Mark(item.Code)</span>
                        <span class="studentName">@Mark(item.Title)</span>
                    </a>
                </div>
            }
        </details>
    }
}