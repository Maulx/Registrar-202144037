@model Models.Course
@{ ViewBag.Title="Cours - Détails"; ViewBag.PageTitle="Cours - Détails"; }
<details id="course_details_infos" open><summary>@Model.Code</summary><div class="detailsPanel"><p>Session @Model.Session</p><p><b>@Model.Title</b></p></div></details>
<h4>Étudiants inscrits</h4>
@foreach(var year in Model.Registrations.Select(r=>r.Year).Distinct().OrderByDescending(y=>y)){ var teacher = Model.Allocations.FirstOrDefault(a=>a.Year==year)?.Teacher; <details id="course_registrations_details_@year" open><summary>Cohorte @year @if(teacher!=null){<span>- <a href="/Teachers/Details/@teacher.Id">@teacher.FullName</a></span>}</summary>@foreach(var r in Model.Registrations.Where(r=>r.Year==year).OrderBy(r=>r.Student.LastName)){<div><a href="/Students/Details/@r.StudentId">@r.Student.Code @r.Student.FullName</a></div>}</details>}
<div class="section roundedBorder currentSession">Session courante : <b>@Models.NextSession.ShortCaption</b></div>
@section Scripts{<script>$(()=>RestoreDetailsState());</script>}
