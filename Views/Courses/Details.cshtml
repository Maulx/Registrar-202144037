@model Models.Course

@{
    ViewBag.Title = "Cours - Détails";
    ViewBag.PageTitle = "Cours - Détails";
}

<div id="courseDetailsPanel">
    @{
        Html.RenderPartial("GetCourseDetails", Model);
    }
</div>

@section Scripts {
    <script>

        function refreshCourseDetails() {

            $("#courseDetailsPanel").load(
                "/Courses/GetCourseDetails",
                function () {
                    RestoreDetailsState();
                }
            );
        }

        setInterval(refreshCourseDetails, 5000);

        $(() => RestoreDetailsState());

    </script>
}