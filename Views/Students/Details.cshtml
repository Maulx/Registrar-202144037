@model Models.Student

@{
    ViewBag.Title = "Étudiant - Détails";
    ViewBag.PageTitle = "Étudiant - Détails";
}

<div id="studentDetailsPanel">
    @{
        Html.RenderPartial("GetStudentDetails", Model);
    }
</div>

@section Scripts {
    <script>
        function refreshStudentDetails() {
            $("#studentDetailsPanel").load("/Students/GetStudentDetails", function () {
                RestoreDetailsState();
            });
        }

        setInterval(refreshStudentDetails, 5000);

        $(() => RestoreDetailsState());
    </script>
}