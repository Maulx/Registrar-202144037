@model Models.Student
@{ ViewBag.Title = ViewBag.Creating ? "Étudiant - Ajout" : "Étudiant - Modification"; ViewBag.PageTitle = ViewBag.Title; bool creating = ViewBag.Creating; string session = ViewBag.Session; }
@using (Html.BeginForm()) {
    @Html.HiddenFor(m=>m.Id)
    @Html.HiddenFor(m=>m.Code)
    <details id="student_form_details_infos" open>
        <summary>Informations - [@Model.Code]</summary>
        <fieldset>
            <label>Prénom</label>@Html.TextBoxFor(m=>m.FirstName, new {@class="form-control"})
            <label>Nom</label>@Html.TextBoxFor(m=>m.LastName, new {@class="form-control"})
            <label>Date de naissance</label>@Html.TextBoxFor(m=>m.BirthDate, "{0:yyyy-MM-dd}", new {@class="form-control", type="date"})
            <label>Courriel</label>@Html.TextBoxFor(m=>m.Email, new {@class="form-control", type="email"})
            <label>Téléphone</label>@Html.TextBoxFor(m=>m.Phone, new {@class="form-control"})
        </fieldset>
    </details>
    if (!creating) {
        <details id="student_form_details_courses" open>
            <summary>Inscriptions : @session</summary>
            @Helper.SelectionLists("selectedCoursesId", (SelectList)ViewBag.Registrations, (SelectList)ViewBag.Courses)
        </details>
    }
    <input type="submit" id="submit" hidden />
}
