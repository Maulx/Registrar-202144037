@model IEnumerable<Models.Student>
@functions{
    public IHtmlString Mark(string value){ string q = HttpContext.Current.Session["SearchString"] as string; if(String.IsNullOrWhiteSpace(q)) return new HtmlString(HttpUtility.HtmlEncode(value)); return new HtmlString(System.Text.RegularExpressions.Regex.Replace(HttpUtility.HtmlEncode(value), System.Text.RegularExpressions.Regex.Escape(HttpUtility.HtmlEncode(q)), "<mark>$0</mark>", System.Text.RegularExpressions.RegexOptions.IgnoreCase)); }
}
@{ var yearsList = ((List<int>)Session["StudentsYearsList"]).OrderByDescending(i => i); }
@foreach (int year in yearsList) {
    var students = Model.Where(s => s.Year == year);
    if (students.Any()) {
        <details id="students_details_@year" open>
            <summary>Cohorte @year</summary>
            @foreach (var item in students) {
                <div class="StudentListLayout"><a href="@Url.Action("Details", new { id = item.Id })"><span class="studentCode">@Mark(item.Code)</span> <span class="studentName">@Mark(item.LastName) @Mark(item.FirstName)</span></a></div>
            }
        </details>
    }
}
