@{
    ViewBag.Title = "Étudiants";
    ViewBag.PageTitle = "Étudiants";
    bool search = Session["Search"] != null && (bool)Session["Search"];
    string searchString = Session["SearchString"] != null ? (string)Session["SearchString"] : "";
}
@if (search) {
    <div class="searchBar registrarSearch">
        <input type="text" id="searchInput" class="section roundedBorder searchBarItem" value="@searchString" placeholder="Recherche..." />
        @{ int selectedYear = Session["SelectedStudentYear"] != null ? (int)Session["SelectedStudentYear"] : 0; var years = Session["StudentsYearsList"] as List<int>; }
        <select id="yearSelect" class="section roundedBorder searchBarItem">
            <option value="0">Toutes les années</option>
            @if (years != null) { foreach (int year in years) { <option value="@year" @(selectedYear == year ? "selected" : "")>@year</option> } }
        </select>
    </div>
}
<div id="studentsContainer"></div>
<div class="section roundedBorder currentSession">Session courante : <b>@Models.NextSession.ShortCaption</b></div>
@section Scripts {
<script>
    let panel;
    $(() => {
        panel = new AutoRefreshedPanel("studentsContainer", "/Students/GetStudents", 5, RestoreDetailsState);
        $("#searchInput").on("change", function () { window.location = "/Students/SetSearchString?value=" + encodeURIComponent($(this).val()); });
        $("#yearSelect").on("change", function () { window.location = "/Students/SetSearchYear?value=" + $(this).val(); });
    });
</script>
}
