@model Models.Teacher

@{
    ViewBag.Title = "Prof - Détails";
    ViewBag.PageTitle = "Prof - Détails";
}

<div id="teacherDetailsPanel">
    @{
        Html.RenderPartial("GetTeacherDetails", Model);
    }
</div>

@section Scripts {
    <script>
        function refreshTeacherDetails() {
            $("#teacherDetailsPanel").load("/Teachers/GetTeacherDetails", function () {
                RestoreDetailsState();
            });
        }

        setInterval(refreshTeacherDetails, 5000);

        $(() => RestoreDetailsState());
    </script>
}