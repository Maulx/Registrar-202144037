@model IEnumerable<Models.Teacher>
@functions{ 
    public IHtmlString Mark(string value) {
        string q = HttpContext.Current.Session["SearchString"] as string; if (String.IsNullOrWhiteSpace(q)) return new HtmlString(HttpUtility.HtmlEncode(value)); return new HtmlString(System.Text.RegularExpressions.Regex.Replace(HttpUtility.HtmlEncode(value), System.Text.RegularExpressions.Regex.Escape(HttpUtility.HtmlEncode(q)), "<mark>$0</mark>", System.Text.RegularExpressions.RegexOptions.IgnoreCase)); }}
@foreach (var item in Model)
{
    <div class="StudentListLayout teacherLine">
        <a href="@Url.Action("Details", new { id=item.Id })"><img src="@Url.Content(item.Avatar)" class="tinyAvatar" /> <span class="studentCode">@Mark(item.Code)</span> <span class="studentName">@Mark(item.LastName) @Mark(item.FirstName)</span></a>
    </div>}
